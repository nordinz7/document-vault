# Password for the encrypted payslip PDF used in parser.test.ts.
# Copy this file to .env and fill in the real value (git-ignored).
PAYSLIP_TEST_PASSWORD=

# Overrides the SQLite file (default: mydb.sqlite at the project root). Used
# verbatim, so ":memory:" works. Set this in any test that touches the DB so it
# never writes to the dev database.
DB_PATH=
